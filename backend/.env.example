# Nodal Sentinel - Backend Environment Configuration Example
# Copy this file to .env and configure local values

# Runtime Environment (development, staging, production, test)
ENVIRONMENT=development

# Network & Bindings
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
DATABASE_URL=sqlite:///./nodal_sentinel.db

# LLM Provider Configuration for AI Investigation
# Supported providers: mock, openai, gemini, anthropic
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# Timeouts & Limits
TIMEOUT_SECONDS=30
APPROVAL_EXPIRY_HOURS=24
MAX_RETRIES=3

# Financial Exposure Thresholds (Integer Paise Minor Units)
# 5000000 paise = ₹50,000.00 | 10000000 paise = ₹1,00,000.00
MAX_AUTOMATED_REMEDIATION_PAISE=5000000
CRITICAL_EXPOSURE_THRESHOLD_PAISE=10000000
